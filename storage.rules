rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      return request.auth.token.email == "crestox@crestox.com";
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Public assets are readable by anyone
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Avatars can be read by anyone, but only written by the owner or admin
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }
    
    // Artworks can be read by anyone, but only written by the owner or admin
    match /artworks/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }
    
    // Achievements can be read by anyone, but only written by the owner or admin
    match /achievements/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // Previously sold art proof can be read by anyone, but only written by the owner or admin
    match /previouslySold/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // Allow admin full access to any other path as a fallback
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
