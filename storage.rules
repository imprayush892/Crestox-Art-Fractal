rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read for all files. Avatars, artwork, etc. are public.
    match /{allPaths=**} {
      allow read;
    }

    // User can only write to their own avatar path.
    match /avatars/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow authenticated users to write to these paths. 
    // The security is based on unguessable UUIDs in file paths.
    match /achievements/{artistId}/{category}/{fileName} {
      allow write: if request.auth != null;
    }
    
    match /previouslySold/{artistId}/{fileName} {
      allow write: if request.auth != null;
    }
    
    // An artist can upload artwork to their own folder.
    match /artworks/{userId}/{fractalId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
