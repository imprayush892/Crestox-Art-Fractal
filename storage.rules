
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access for specific folders containing public assets.
    match /founders/{imageName} {
      allow read;
      allow write: if request.auth != null; // Keep writes restricted
    }

    match /public/{allPaths=**} {
      allow read;
      allow write: if request.auth != null; // Keep writes restricted
    }

    // All other paths require authentication to be read or written.
    // This is a secure default for user-specific files.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
