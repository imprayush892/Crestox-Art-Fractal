rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Allow public read access to all files in the 'public' folder.
    // This is useful for assets like the company wordmark.
    match /public/{allPaths=**} {
      allow read: if true;
    }

    // Avatars can be read by anyone.
    // Only the authenticated user can write to their own avatar directory.
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Artwork images can be read by anyone.
    // Writes are restricted to the owner of the user directory.
    match /artworks/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Achievement images (awards, exhibitions) can be read by anyone.
    // Writes are restricted to the authenticated user's own directory.
    match /achievements/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Previously sold artwork images can be read by anyone.
    // Writes are restricted to the authenticated user's own directory.
    match /previouslySold/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

  }
}
