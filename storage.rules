
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public assets like logos are readable by everyone
    match /public/{allPaths=**} {
      allow read;
    }
    
    // Artist avatars can be written by the user, read by anyone
    match /avatars/{userId}/{allPaths=**} {
      allow read;
      allow write: if request.auth.uid == userId;
    }

    // Artwork images can be written by the user, read by anyone
    match /artworks/{userId}/{allPaths=**} {
      allow read;
      allow write: if request.auth.uid == userId;
    }

    // Award and Exhibition images
    match /achievements/{artistId}/{allPaths=**} {
      allow read;
      // Allow write if the user is the artist associated with this artistId
      allow write: if request.auth != null && get(/databases/$(database)/documents/artists/$(artistId)).data.userId == request.auth.uid;
    }
  }
}
