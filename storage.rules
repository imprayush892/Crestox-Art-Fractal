
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow anyone to read any file. This is useful for public assets like artwork.
    match /{allPaths=**} {
      allow read: if true;
    }

    // Allow authenticated users to upload their own avatar.
    // Avatars are stored at /avatars/{userId}
    match /avatars/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated artists to upload their own artwork.
    // Artworks are stored at /artworks/{userId}/{fractalId}/{fileName}
    match /artworks/{userId}/{fractalId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

    