
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow artists to upload artwork to a folder corresponding to their user ID.
    // They can read, write, and delete files within their own folder.
    match /artworks/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
