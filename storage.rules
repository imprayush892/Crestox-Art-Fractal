rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      // IMPORTANT: Replace with your admin email
      return request.auth.token.email == 'admin@example.com';
    }
  
    // Allow public read on all files
    allow read: if true;
    
    // Users can write to their own designated folders
    match /avatars/{userId}/{fileName} {
      allow write: if request.auth.uid == userId || isAdmin();
    }
    match /achievements/{userId}/{allPaths=**} {
      allow write: if request.auth.uid == userId || isAdmin();
    }
    match /artworks/{userId}/{allPaths=**} {
      allow write: if request.auth.uid == userId || isAdmin();
    }
     match /previouslySold/{userId}/{allPaths=**} {
      allow write: if request.auth.uid == userId || isAdmin();
    }
    
    // Admin can write to public/founder folders
    match /public/{allPaths=**} {
      allow write: if isAdmin();
    }
    match /founders/{allPaths=**} {
      allow write: if isAdmin();
    }
  }
}
