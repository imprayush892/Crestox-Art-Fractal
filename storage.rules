
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // 1. Artwork Images
    // Allow artists to upload images to a folder corresponding to their user ID.
    // This keeps an artist's uploads organized and secure.
    match /artworks/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow public read access to all artwork images so they can be displayed in the app.
    match /artworks/{allPaths=**} {
      allow read: if true;
    }

    // 2. Avatar Images
    // Allow any authenticated user to upload their own avatar.
    match /avatars/{userId}/{allPaths=**} {
        allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow public read for all avatars.
     match /avatars/{allPaths=**} {
      allow read: if true;
    }
  }
}
