rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all mock artwork images
    match /MockArtWork/{allPaths=**} {
      allow read;
      allow write: if false; // Disallow public writes
    }

    // Allow authenticated users to read and write to their own folders
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /achievements/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /artworks/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

     match /previouslySold/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow public read for assets
     match /public/assets/{allPaths=**} {
      allow read;
      allow write: if false;
    }
    
    // Allow public read for founder images
    match /founders/{allPaths=**} {
      allow read;
      allow write: if false;
    }
  }
}
