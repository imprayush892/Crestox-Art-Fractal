[debug] [2025-07-19T10:50:34.709Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"\nrules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // --- Helper Functions ---\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function isOwner(userId) {\n      return request.auth.uid == userId;\n    }\n\n    function isAdmin() {\n      // Check for a custom claim 'admin' on the auth token.\n      // This must be set via the Firebase Admin SDK.\n      return request.auth.token.admin == true;\n    }\n\n    // This function checks if a non-owner update on a user document\n    // is a valid seller payout from a transaction. It uses a blacklist approach\n    // to ensure sensitive fields are not changed, while allowing transactional fields to update.\n    function isSellerPayout() {\n      let before = resource.data;\n      let after = request.resource.data;\n\n      // Ensure sensitive fields are unchanged\n      let isSensitiveDataSafe = before.email == after.email &&\n                                before.firstName == after.firstName &&\n                                before.lastName == after.lastName;\n\n      // Ensure wallet balance only increases\n      let isBalanceCorrect = after.walletBalance >= before.walletBalance;\n\n      return isAuthenticated() && isSensitiveDataSafe && isBalanceCorrect;\n    }\n\n    // This function checks if a non-owner update on a resale listing\n    // is a valid purchase transaction.\n    function isValidListingUpdate() {\n        let before = resource.data;\n        let after = request.resource.data;\n\n        // Core data must not change\n        let coreDataUnchanged = before.artistId == after.artistId &&\n                                before.resellerId == after.resellerId &&\n                                before.initialPrice == after.initialPrice &&\n                                before.minPrice == after.minPrice &&\n                                before.periodSeconds == after.periodSeconds;\n\n        // Transactional data must change correctly\n        let quantityDecreased = after.quantity < before.quantity;\n        let holdingsDecreased = after.holdingIds.size() < before.holdingIds.size();\n        let statusValid = (after.status == 'active' && quantityDecreased) || \n                          (after.status == 'completed' && after.quantity == 0);\n\n        return isAuthenticated() &&\n               coreDataUnchanged &&\n               statusValid &&\n               holdingsDecreased;\n    }\n\n    // This function checks if a non-owner update on an artist document\n    // is a valid transactional financial update.\n    function isArtistFinancialUpdate() {\n      let before = resource.data;\n      let after = request.resource.data;\n      \n      // Ensure artist identity fields are not changed by a transaction\n      return before.userId == after.userId &&\n             before.name == after.name &&\n             before.avatar == after.avatar &&\n             before.bio == after.bio;\n    }\n\n    // --- Notification Rules ---\n    match /admin_notifications/{notificationId} {\n      allow create: if isAuthenticated(); // Any authenticated user can notify the admin\n      allow read, update, delete: if isAdmin(); // Only admins can manage these notifications\n    }\n\n    match /users/{userId}/notifications/{notificationId} {\n      allow create: if isAdmin(); // Only admins can create notifications for users\n      allow read, update: if isOwner(userId); // Users can only manage their own notifications\n    }\n\n    // --- Collection Group Rules ---\n    // This allows the \"Collectors\" tab query to work.\n    match /{path=**}/holdings/{holdingId} {\n      allow read: if isAuthenticated();\n    }\n\n    // --- Public Collections ---\n    match /artists/{artistId} {\n      allow get, list: if true;\n      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;\n      // Allow artist to update their own profile, or allow a transaction to update financial fields.\n      allow update: if isAuthenticated() && (isOwner(resource.data.userId) || isArtistFinancialUpdate());\n    }\n\n    match /fractals/{fractalId} {\n      allow read: if true;\n      // Allow updates during transactions by any authenticated user.\n      allow create, update: if isAuthenticated();\n    }\n\n    match /resaleListings/{listingId} {\n      allow read: if true;\n      allow create: if isAuthenticated() && isOwner(request.resource.data.resellerId);\n      // Allow updates only under specific, secure conditions\n      allow update: if \n        // Allow the owner to cancel the listing\n        (isOwner(resource.data.resellerId) && request.resource.data.status == 'cancelled') ||\n        // Allow a buyer to update the listing during a purchase\n        isValidListingUpdate();\n    }\n\n    // --- User Data ---\n    match /users/{userId} {\n      allow get: if isAuthenticated();\n      // NOTE: list permission is required for the app to find user profiles by ID.\n      allow list: if isAuthenticated(); \n      allow create: if isOwner(userId);\n      // Allow user to update their own data, or allow a transaction to update a seller's data.\n      allow update: if isOwner(userId) || isSellerPayout();\n\n      // --- User-Specific Subcollections ---\n      match /holdings/{holdingId} {\n        allow get: if isAuthenticated(); \n        allow list: if isOwner(userId);\n        allow create, update: if isOwner(userId);\n        // NOTE: Permissive delete is required for the client-side transaction to transfer holdings.\n        allow delete: if isAuthenticated();\n      }\n      \n      match /privateHoldings/{holdingId} {\n        allow read, list, create, update: if isOwner(userId);\n        // NOTE: Permissive delete is required for the client-side transaction. The data is private and cannot be read.\n        allow delete: if isAuthenticated();\n      }\n    }\n    // As a failsafe, admin has full access to everything.\n    // This rule is placed last to be evaluated after more specific rules.\n    match /{document=**} {\n      allow read, write: if isAdmin();\n    }\n  }\n}\n"}]}}
