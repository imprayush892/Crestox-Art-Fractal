[debug] [2025-07-06T08:36:01.555Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    function isAdmin() {\n      return request.auth.token.email == \"crestox@crestox.com\";\n    }\n    \n    function isOwner(userId) {\n      return request.auth.uid == userId;\n    }\n\n    // Public collections are readable by anyone logged in\n    match /artists/{artistId} {\n      allow read: if request.auth != null;\n      // Allow artists to create/update their own profiles\n      allow create, update: if request.auth.uid == resource.data.userId || isAdmin();\n    }\n    \n    match /fractals/{fractalId} {\n      allow read: if request.auth != null;\n      // Allow artists to create/update their own fractals\n      allow create, update: if get(/databases/$(database)/documents/artists/$(request.resource.data.artistId)).data.userId == request.auth.uid || isAdmin();\n    }\n    \n    // Users can manage their own data\n    match /users/{userId} {\n      allow read, write: if isOwner(userId) || isAdmin();\n      \n      // Holdings can be read and written by the owner\n      match /holdings/{holdingId} {\n        allow read, write: if isOwner(userId) || isAdmin();\n      }\n      match /privateHoldings/{holdingId} {\n         allow read, write: if isOwner(userId) || isAdmin();\n      }\n    }\n    \n    // Resale listings can be read by authenticated users.\n    // They can only be created or updated by the lister.\n    match /resaleListings/{listingId} {\n        allow read: if request.auth != null;\n        allow create: if request.auth.uid == request.resource.data.resellerId || isAdmin();\n        allow update: if request.auth.uid == resource.data.resellerId || isAdmin();\n    }\n\n    // As a failsafe, admin has full access to everything.\n    // This rule is placed last to be evaluated after more specific rules.\n    match /{document=**} {\n      allow read, write: if isAdmin();\n    }\n  }\n}\n"}]}}
