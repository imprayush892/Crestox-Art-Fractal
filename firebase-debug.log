[debug] [2025-07-19T08:55:33.912Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    // Allow public read for artists and fractals\n    match /artists/{artistId} {\n      allow read: if true;\n      allow write: if request.auth != null && request.auth.uid == resource.data.userId;\n    }\n\n    match /fractals/{fractalId} {\n      allow read: if true;\n      allow write: if request.auth != null; // More specific rules might be needed\n    }\n    \n    // Users can read/write their own data\n    match /users/{userId} {\n      allow read, write: if request.auth != null && request.auth.uid == userId;\n      \n      // Holdings are complex. For now, allow owner to manage.\n      match /holdings/{holdingId} {\n        allow read, write: if request.auth != null && request.auth.uid == userId;\n      }\n      match /privateHoldings/{holdingId} {\n        allow read, write: if request.auth != null && request.auth.uid == userId;\n      }\n      match /notifications/{notificationId} {\n         allow read, write: if request.auth != null && request.auth.uid == userId;\n      }\n    }\n\n    // Resale listings can be read by anyone, written by owner\n    match /resaleListings/{listingId} {\n      allow read: if true;\n      allow write: if request.auth != null && request.auth.uid == request.resource.data.resellerId;\n    }\n    \n    // Admin notifications can be created by any user, but only read/updated by admin.\n    match /admin_notifications/{notificationId} {\n      allow read, update: if request.auth != null && request.auth.token.email == \"crestox@crestox.com\";\n      allow create: if request.auth != null;\n    }\n  }\n}\n"}]}}
