
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- User Profile and Wallet ---
    match /users/{userId} {
      // ANY authenticated user can READ any user's profile.
      // This is necessary for the buyer's client to read the seller's data during a transaction.
      allow read: if request.auth.uid != null;
      
      // A user can CREATE and WRITE to their OWN profile (e.g., update watchlist).
      allow create, write: if request.auth.uid == userId;
      
      // A different user can UPDATE a profile, but ONLY to increase the wallet balance.
      // This allows a buyer to securely pay a seller without having full write access.
      allow update: if request.auth.uid != null &&
                     request.resource.data.walletBalance > resource.data.walletBalance &&
                     request.resource.data.keys().hasOnly(['walletBalance']);
      
      // --- User's Private Fractal Holdings ---
      match /holdings/{holdingId} {
        // ANY authenticated user can READ holdings.
        // This lets the buyer's client verify the holding exists before purchase.
        allow read: if request.auth.uid != null;
        
        // A user can CREATE and UPDATE THEIR OWN holdings.
        // The UPDATE permission is critical for changing a holding's status to 'listed'.
        allow create, update: if request.auth.uid == userId;
        
        // ANY authenticated user can DELETE a holding (buyer taking ownership from seller).
        // This is safe because it's wrapped in a transaction that ensures payment.
        allow delete: if request.auth.uid != null;
      }
    }

    // --- Public Data: Artists, Fractals, Listings ---
    // These collections can be read by anyone, but only written/updated by authenticated users.
    // The application logic handles the specifics of who can update what.
    match /artists/{artistId} {
      allow read: if true;
      allow create, update: if request.auth.uid != null;
    }

    match /fractals/{fractalId} {
      allow read: if true;
      allow create, update: if request.auth.uid != null;
    }

    match /resaleListings/{listingId} {
      allow read: if true;
      allow create, update, delete: if request.auth.uid != null;
    }
  }
}
