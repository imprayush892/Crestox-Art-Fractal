rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read and write to their own document.
    match /users/{userId} {
      allow read, update, write: if request.auth.uid == userId;
      allow create: if request.auth.uid != null;
      
      // A user can create and delete their own holdings.
      match /holdings/{holdingId} {
        allow read, create, delete: if request.auth.uid == userId;
        // No updates to holdings; they are created/deleted.
        allow update: if false;
      }
    }

    // Artists can be read by anyone.
    // An authenticated user can update an artist's document (e.g. for a sale).
    match /artists/{artistId} {
      allow read: if true;
      allow create, update: if request.auth.uid != null;
    }

    // Fractals can be read by anyone.
    // An authenticated user can update a fractal's document (e.g. for re-evaluation).
    match /fractals/{fractalId} {
      allow read: if true;
      allow create, update: if request.auth.uid != null;
    }

    // Resale listings can be read by anyone.
    // An authenticated user can create/update listings.
    match /resaleListings/{listingId} {
        allow read: if true;
        allow create, update: if request.auth.uid != null;
    }
  }
}
