
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // USERS
    match /users/{userId} {
      // A user can create their own document if their auth uid matches the uid in the document.
      allow create: if request.auth.uid != null && request.resource.data.uid == request.auth.uid;
      
      // A user can only read or update their own document.
      allow read, update: if request.auth.uid == userId;

      // Allow users to manage their own holdings subcollection.
      match /holdings/{holdingId} {
        allow read, write: if request.auth.uid == userId;
      }
    }
    
    // ARTISTS
    match /artists/{artistId} {
      // Anyone can view artist profiles.
      allow read: if true;
      
      // Only the authenticated user associated with the artist profile can write to it.
      allow create, update: if request.auth.uid == request.resource.data.userId;
    }

    // FRACTALS (ARTWORK)
    match /fractals/{fractalId} {
      // Anyone can view artwork.
      allow read: if true;
      
      // Only the authenticated artist can create or update their own artwork.
      // This rule looks up the artist document to verify ownership.
      allow create, update: if get(/databases/$(database)/documents/artists/$(request.resource.data.artistId)).data.userId == request.auth.uid;
    }

    // RESALE LISTINGS
    match /resaleListings/{listingId} {
      // Anyone can view items on the resale market.
      allow read: if true;
      
      // An authenticated user can create a listing.
      allow create: if request.auth.uid != null;
      
      // Only the user who created the listing can cancel it (update its status).
      allow update: if request.auth.uid == resource.data.resellerId;
    }
  }
}
