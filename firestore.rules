rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- Public Collections ---
    match /artists/{artistId} {
      allow read: if true;
      allow update: if isAuthenticated();
    }

    match /fractals/{fractalId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.resource.data.artistId == request.auth.uid;
    }

    match /resaleListings/{listingId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
    }

    // --- User Data ---
    match /users/{userId} {
      allow get, list: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) ||
                       (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletBalance']));

      // --- User Subcollections ---
      match /holdings/{holdingId} {
        // This rule allows any authenticated user to list holdings, which is required for the collection group query to fetch collectors.
        allow read: if isAuthenticated();
        // Only the owner can create or update their own holdings.
        allow create, update: if isOwner(userId);
        // Any authenticated user can delete a holding (for transaction purposes).
        allow delete: if isAuthenticated();
      }

      match /privateHoldings/{holdingId} {
        // Only the owner can list their own private holdings.
        allow list: if isOwner(userId);
        // Any authenticated user can get a specific private holding (for verification).
        allow get: if isAuthenticated();
        // Only the owner can create or update their own private holdings.
        allow create, update: if isOwner(userId);
        // Any authenticated user can delete a private holding (for transaction purposes).
        allow delete: if isAuthenticated();
      }
    }
  }
}
