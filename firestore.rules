
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;

      // Holdings are private but need to be queryable by a collectionGroup for the collectors list
      match /holdings/{holdingId} {
        allow read, write: if request.auth.uid == userId;
      }
      match /privateHoldings/{holdingId} {
        allow read, write: if request.auth.uid == userId;
      }
    }
    
    // Allow collectionGroup query on 'holdings' for authenticated users
    match /{path=**}/holdings/{holdingId} {
      allow read: if request.auth != null;
    }

    // Artists are public
    match /artists/{artistId} {
      allow read: if true;
      allow create: if request.auth != null; // Anyone logged in can create a profile
      allow update: if request.auth.uid == resource.data.userId; // Only the owner can update
    }

    // Fractals are public
    match /fractals/{fractalId} {
        allow read: if true;
        // Only the artist can create/update their own fractals
        allow create, update: if request.auth != null && get(/databases/$(database)/documents/artists/request.resource.data.artistId).data.userId == request.auth.uid;
    }
    
    // Resale listings are public
    match /resaleListings/{listingId} {
        allow read: if true;
        allow create: if request.auth.uid == request.resource.data.resellerId;
        allow update: if request.auth.uid == resource.data.resellerId;
    }
  }
}
