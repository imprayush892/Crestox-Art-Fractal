rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /artists/{artistId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Artist can update their own profile.
      // A buyer can update market-related fields during a purchase.
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid) || 
                       (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().subsetOf(['fractalPrice', 'priceHistory', 'availableEditions']));
    }
    
    match /fractals/{fractalId} {
      allow read: if true;
      // Artist can write to their own fractals.
      allow write: if isAuthenticated() && get(/databases/$(database)/documents/artists/$(resource.data.artistId)).data.userId == request.auth.uid;
    }

    match /resaleListings/{listingId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.resellerId == request.auth.uid;
      // Owner can update. Buyer can update specific fields for a sale.
      allow update: if (isAuthenticated() && resource.data.resellerId == request.auth.uid) ||
                       (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'status', 'holdingIds']));
    }
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      // Owner can update. Buyer can only update walletBalance.
      allow update: if isOwner(userId) || 
                       (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletBalance']));
              
      match /holdings/{holdingId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId);
        // A user can update their own holding (e.g., to mark it as listed).
        allow update: if isOwner(userId);
        // SECURITY NOTE: Any authenticated user can delete a holding.
        // This is necessary for the client-side purchase transaction to work
        // but should be moved to a Cloud Function in a production app.
        allow delete: if isAuthenticated();
      }
      
      match /privateHoldings/{holdingId} {
        allow read, create, update: if isOwner(userId);
        // SECURITY NOTE: Same as public holdings. Required for client-side transaction.
        allow delete: if isAuthenticated();
      }
    }
  }
}
