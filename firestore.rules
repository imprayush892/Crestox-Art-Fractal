rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Public read for primary data, authenticated write
    match /artists/{artistId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /fractals/{fractalId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /resaleListings/{listingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Rules for the users collection
    match /users/{userId} {
      // Allow read for any authenticated user.
      allow read: if request.auth != null;
      
      // Allow any authenticated user to update another user's document.
      // This is necessary for the transaction where the buyer's action credits the seller's wallet.
      // The transaction logic is the security boundary.
      allow update: if request.auth != null;
      
      // A user can only create their own user document.
      allow create: if request.auth.uid == userId;
      
      // A user can only delete their own account.
      allow delete: if request.auth.uid == userId;
      
      // Holdings can be created/deleted by any authenticated user during a transaction.
      match /holdings/{holdingId} {
        allow read: if request.auth != null;
        allow write, delete: if request.auth != null;
      }
      
      // Private holdings are only readable by the owner, but writable by anyone during a transaction.
      match /privateHoldings/{holdingId} {
         allow read: if request.auth.uid == userId;
         allow write, delete: if request.auth != null;
      }
    }
  }
}
