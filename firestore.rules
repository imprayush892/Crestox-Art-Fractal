rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read and write to their own document. A user's document
    // may also be updated by another user during a purchase transaction.
    match /users/{userId} {
      allow read, create: if request.auth.uid == userId;
      allow update: if request.auth.uid != null;
      allow delete: if request.auth.uid == userId;
      
      // A user can create and delete their own holdings. A holding can also
      // be deleted by another user during a purchase transaction.
      match /holdings/{holdingId} {
        allow read, create: if request.auth.uid == userId;
        allow delete: if request.auth.uid != null;
        allow update: if false; // Holdings should not be updated directly
      }
    }

    // Artists can be read by anyone.
    // An authenticated user can create/update an artist's document.
    match /artists/{artistId} {
      allow read: if true;
      allow create, update: if request.auth.uid != null;
    }

    // Fractals can be read by anyone.
    // An authenticated user can create/update a fractal's document.
    match /fractals/{fractalId} {
      allow read: if true;
      allow create, update: if request.auth.uid != null;
    }

    // Resale listings can be read by anyone.
    // An authenticated user can create/update listings.
    match /resaleListings/{listingId} {
        allow read: if true;
        allow create, update: if request.auth.uid != null;
    }
  }
}
