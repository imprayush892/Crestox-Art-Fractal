rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      // IMPORTANT: Replace with your actual admin email address
      return request.auth.token.email == 'admin@example.com';
    }

    // Users can read public data, but only manage their own private data
    match /users/{userId} {
      allow read: if true; // Public user data is readable
      allow write: if request.auth.uid == userId || isAdmin();
    }
    
    match /users/{userId}/holdings/{holdingId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId || isAdmin();
    }
    
    match /users/{userId}/privateHoldings/{holdingId} {
       allow read, write: if request.auth.uid == userId || isAdmin();
    }
    
    // Artists can be read by anyone, but only updated by their owner or admin
    match /artists/{artistId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if (resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Fractals can be read by anyone, but writes are restricted.
    match /fractals/{fractalId} {
      allow read: if true;
      // Writes are complex and handled by server-side logic (transactions in auth-context).
      // This rule allows authenticated users (running the server action) and admins to write.
      allow write: if request.auth != null || isAdmin();
    }
    
    // Resale listings can be read by anyone. Writes are restricted.
    match /resaleListings/{listingId} {
        allow read: if true;
        allow create: if request.auth.uid == request.resource.data.resellerId || isAdmin();
        allow update: if request.auth.uid == resource.data.resellerId || isAdmin();
        allow delete: if isAdmin();
    }
  }
}
