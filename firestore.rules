rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function isAuth() {
      return request.auth != null;
    }

    match /users/{userId} {
      // Users can create their own profile.
      allow create: if isOwner(userId);
      // Users can read their own profile.
      allow read: if isOwner(userId);
      // Users can update their own wallet balance and watchlist.
      allow update: if isOwner(userId) && request.resource.data.keys().hasAll(['walletBalance', 'watchlist']);
      
      // Allow authenticated users to update another user's wallet balance
      // (This is required for sellers in a resale transaction)
      allow update: if isAuth() && request.resource.data.keys().hasAll(['walletBalance']);

      match /holdings/{holdingId} {
        // Users can manage their own holdings.
        allow read, create, delete: if isOwner(userId);
        // A user can update a holding's status (e.g., from 'owned' to 'listed').
        allow update: if isOwner(userId) && request.resource.data.keys().hasAll(['status']);
      }
    }
    
    match /artists/{artistId} {
      // Anyone can view artist profiles.
      allow read: if true;
      // Artists can create and update their own profiles.
      allow create, update: if isOwner(artistId);
    }
    
    match /fractals/{fractalId} {
      // Anyone can view artwork.
      allow read: if true;
      // Only the artist can create or update their own artwork.
      allow create, update: if isAuth() && get(/databases/$(database)/documents/artists/$(request.resource.data.artistId)).data.userId == request.auth.uid;
    }
    
    match /resaleListings/{listingId} {
      // Anyone can view resale listings.
      allow read: if true;
      // Authenticated users can create listings.
      allow create: if isAuth();
      // Only the lister can cancel it, but any authenticated user can update it (to complete a purchase).
      allow update: if isAuth();
    }
  }
}
