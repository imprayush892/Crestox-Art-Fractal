rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1️⃣ User profiles (e.g. collection “users”)
    match /users/{userId} {
      // A new user may create their own profile doc at /users/$(uid)
      allow create: if request.auth.uid == userId;
      // Any visitor can read public profiles, but full details only to the owner
      allow read: if true; 
      allow update: if request.auth.uid == userId;
      allow delete: if false;
    }

    // 2️⃣ Artist profiles (e.g. collection “artists”)
    match /artists/{artistId} {
      allow create: if request.auth.uid == artistId;
      allow read:   if true;                          // public listing of all artists
      allow update: if request.auth.uid == artistId;  // only artist themself
      allow delete: if false;
    }

    // 3️⃣ Fractals (artwork) collection
    match /fractals/{fractalId} {
      allow read: if true; // everyone can browse art
      allow create: if request.auth.uid != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth.uid == resource.data.ownerId;
    }

    // 4️⃣ Resale listings
    match /resaleListings/{listingId} {
      allow read: if true; // public marketplace
      allow create: if request.auth.uid == request.resource.data.sellerId;
      allow update, delete:
        if request.auth.uid == resource.data.sellerId;
    }

  }
}
