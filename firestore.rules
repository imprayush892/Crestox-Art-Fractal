rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public read for artists and fractals
    match /artists/{artistId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /fractals/{fractalId} {
      allow read: if true;
      allow write: if request.auth != null; // More specific rules might be needed
    }
    
    // Users can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Holdings are complex. For now, allow owner to manage.
      match /holdings/{holdingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /privateHoldings/{holdingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /notifications/{notificationId} {
         allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Resale listings can be read by anyone, written by owner
    match /resaleListings/{listingId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.resellerId;
    }
    
    // Admin notifications can be created by any user, but only read/updated by admin.
    match /admin_notifications/{notificationId} {
      allow read, update: if request.auth != null && request.auth.token.email == "crestox@crestox.com";
      allow create: if request.auth != null;
    }
  }
}
