
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- PUBLIC DATA ---
    // Anyone can read artists and fractals
    match /artists/{artistId} {
      allow get, list: if true;
      // Allow any authenticated user to perform the necessary updates for purchases.
      // This is simplified for the client-side transaction model.
      allow update: if isAuthenticated(); 
    }

    match /fractals/{fractalId} {
      allow get, list: if true;
      allow write: if false; // Artworks created via transactions, not directly
    }

    // --- MARKETPLACE DATA ---
    // Anyone can see listings, but only authenticated users can create/update them
    match /resaleListings/{listingId} {
      allow get, list: if true;
      allow create, update: if isAuthenticated();
    }

    // Rule for collectionGroup query on 'holdings' to get collector lists
    match /{path=**}/holdings/{holdingId} {
      allow list: if isAuthenticated();
    }

    // --- USER DATA ---
    match /users/{userId} {
      // Anyone can read a user's public profile
      allow get, list: if true; 
      // Only the owner can create their profile or update anything other than their wallet
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || 
                     (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletBalance']));
      allow delete: if false; // Users can't delete their accounts this way
      
      // Public Holdings - these are linked to a specific user
      match /holdings/{holdingId} {
        allow get: if isAuthenticated(); // Covered by collectionGroup rule, but explicit is good
        allow create, update: if isOwner(userId);
        // An authenticated user (the buyer) needs to be able to delete another user's (the seller's) holding
        allow delete: if isAuthenticated();
      }

      // Private Holdings - these contain sensitive purchase data
      match /privateHoldings/{holdingId} {
        // THIS IS THE KEY FIX: A buyer needs to be able to 'get' the seller's private holding doc during the transaction
        allow get: if isAuthenticated();
        // Only the owner can list their own private holdings
        allow list: if isOwner(userId);
        // Only the owner can create/update their own private holdings
        allow create, update: if isOwner(userId);
        // An authenticated user (the buyer) needs to be able to delete another user's (the seller's) private holding
        allow delete: if isAuthenticated();
      }
    }
  }
}
