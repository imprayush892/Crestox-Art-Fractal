rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Authenticated users can read public user profiles.
      // A user can only write to their own document.
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;

      match /holdings/{holdingId} {
        // A user can read and write to their own holdings.
        allow read, write: if request.auth.uid == userId;
        // A different authenticated user can delete a holding as part of a purchase.
        allow delete: if request.auth.uid != null && request.auth.uid != userId;
      }
    }

    // Artists can be read by anyone.
    // An authenticated user can create or update an artist document.
    match /artists/{artistId} {
      allow read: if true;
      allow create, update: if request.auth.uid != null;
    }

    // Fractals can be read by anyone.
    // An authenticated user can create or update a fractal document.
    match /fractals/{fractalId} {
      allow read: if true;
      allow create, update: if request.auth.uid != null;
    }

    // Resale listings can be read by anyone.
    // An authenticated user can create or update a resale listing.
    match /resaleListings/{listingId} {
      allow read: if true;
      allow create, update: if request.auth.uid != null;
    }
  }
}
