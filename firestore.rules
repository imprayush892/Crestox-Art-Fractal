rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // A user can read their own document, and other users' public profiles.
      allow read: if request.auth != null;
      // A user can create their own document on signup.
      allow create: if request.auth.uid == userId;
      // Allow any authenticated user to update any user document.
      // This is required for a buyer to credit a seller's wallet during a transaction.
      // The transaction logic itself provides the safety checks (e.g., verifying balances).
      allow update: if request.auth != null;
      // A user can only delete their own account.
      allow delete: if request.auth.uid == userId;

      match /holdings/{holdingId} {
        // A user can read and create their own holdings.
        allow read, create: if request.auth.uid == userId;
        // Allow any authenticated user to delete any holding.
        // This is required for a buyer to take ownership from a seller during a transaction.
        allow delete: if request.auth != null;
        // Holdings should not be updated directly, only created or deleted.
        allow update: if false;
      }
    }

    // Artists can be read by anyone.
    // An authenticated user can update an artist's document (e.g. for a sale).
    match /artists/{artistId} {
      allow read: if true;
      allow create, update: if request.auth.uid != null;
    }

    // Fractals can be read by anyone.
    // An authenticated user can update a fractal's document (e.g. for re-evaluation).
    match /fractals/{fractalId} {
      allow read: if true;
      allow create, update: if request.auth.uid != null;
    }

    // Resale listings can be read by anyone.
    // An authenticated user can create/update listings.
    match /resaleListings/{listingId} {
        allow read: if true;
        allow create, update: if request.auth.uid != null;
    }
  }
}
