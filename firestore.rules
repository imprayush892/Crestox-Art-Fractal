rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- Collection Group Rules ---
    // This allows the "Collectors" tab query to work.
    match /{path=**}/holdings/{holdingId} {
      allow read: if isAuthenticated();
    }

    // --- Public Collections ---
    match /artists/{artistId} {
      allow get: if true; // Public can get a specific artist if they know the ID
      allow list: if isAuthenticated(); // Authenticated users can query the list (e.g., to find their own profile)
      allow create: if isAuthenticated(); // Authenticated users can create a profile
      allow update: if isAuthenticated() && isOwner(resource.data.userId); // Only owner can update
    }

    match /fractals/{fractalId} {
      allow read: if true;
      allow create, update: if isAuthenticated(); // For artists and transactions
    }

    match /resaleListings/{listingId} {
      allow read: if true;
      allow create: if isAuthenticated();
      // Allow updates only under specific, secure conditions
      allow update: if 
        // Allow the owner to cancel the listing
        (isOwner(resource.data.resellerId) && request.resource.data.status == 'cancelled') ||
        // Allow a buyer to update quantity/status, but not price or other fields
        (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'holdingIds', 'status']));
    }

    // --- User Data ---
    match /users/{userId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated(); 
      allow create: if isOwner(userId);
      // Allow user to update own data, or allow a transaction to update balance and holdings count
      allow update: if isOwner(userId) || 
                     (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletBalance', 'holdingsByArtist']));

      // --- User-Specific Subcollections ---
      match /holdings/{holdingId} {
        // Allow reads for owners and for others to check existence.
        allow get: if isAuthenticated(); 
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId);
        // Allow any authenticated user (i.e., a buyer) to delete a holding during a transaction.
        allow delete: if isAuthenticated();
      }
      
      match /privateHoldings/{holdingId} {
        // Private data is only readable/listable by the owner.
        allow read, list, create, update: if isOwner(userId);
        // Allow any authenticated user (a buyer) to delete a private holding during a transaction, but NOT read it.
        allow delete: if isAuthenticated();
      }
    }
  }
}
