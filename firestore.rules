rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- User Data ---
    match /users/{userId} {
      // Allow user to write to their own data
      allow write: if isOwner(userId);
      // Allow user to read their own full document
      allow get: if isOwner(userId);
      // Allow any authenticated user to read public-facing user profiles (via a query on the 'users' collection)
      allow list: if isAuthenticated();

      // Allow any authenticated user to update ONLY the walletBalance of another user
      allow update: if isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletBalance']);

      match /holdings/{holdingId} {
        // Owner can do anything.
        allow read, write: if isOwner(userId);
        
        // Any authenticated user can get a single public holding (for transaction verification) and delete it.
        allow get, delete: if isAuthenticated();
      }

      match /privateHoldings/{holdingId} {
        // Owner can write and list their private holdings.
        allow write, list: if isOwner(userId);
        
        // Any authenticated user can GET or DELETE a specific private holding doc.
        // This is required for the marketplace purchase transaction to verify and transfer ownership.
        // Listing all private holdings remains restricted to the owner.
        allow get, delete: if isAuthenticated();
      }
    }

    // --- Artists & Fractals (Public) ---
    match /artists/{artistId} {
      allow read: if true;
      allow update: if isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fractalPrice', 'priceHistory', 'availableEditions', 'totalPortfolioValueHistory']);
      allow create: if isAuthenticated();
    }
    
    match /fractals/{fractalId} {
        allow read: if true;
        // Only allow creation/updates by authenticated users. More specific rules can be added if needed.
        allow create, update: if isAuthenticated();
    }

    // --- Resale Listings (Public) ---
    match /resaleListings/{listingId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'status', 'holdingIds']);
    }

    // --- Collection Group Queries ---
    match /{path=**}/holdings/{holdingId} {
      // Allow authenticated users to perform collection group queries on 'holdings'
      allow list: if isAuthenticated();
    }
  }
}
