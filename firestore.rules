
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own data, but other users can also read their public profile info.
    // We also need a special rule to allow a buyer to update a seller's wallet.
    match /users/{userId} {
      allow read: if request.auth.uid != null; // Allow any authenticated user to read user profiles
      allow create: if request.auth.uid == userId; // Allow user to create their own doc
      
      // A user can update their own doc. A buyer can update a seller's wallet if the balance increases.
      allow update: if request.auth.uid == userId || 
                       (request.auth.uid != null && request.resource.data.walletBalance >= resource.data.walletBalance);
      
      // Holdings rules
      match /holdings/{holdingId} {
        // A user can read, create, and update their own holdings.
        allow read, create, update: if request.auth.uid == userId;
        // ANY authenticated user can delete a holding (as part of a purchase).
        // This is safe because it happens inside a transaction that also debits their wallet.
        allow delete: if request.auth.uid != null; 
      }
    }

    // Artists can be read by anyone.
    // Any authenticated user can create or update an artist document.
    match /artists/{artistId} {
      allow read: if true;
      allow create, update: if request.auth.uid != null;
    }

    // Fractals can be read by anyone.
    // Any authenticated user can create or update a fractal document.
    match /fractals/{fractalId} {
      allow read: if true;
      allow create, update: if request.auth.uid != null;
    }

    // Resale listings can be read by anyone.
    // Any authenticated user can create or update a listing.
    match /resaleListings/{listingId} {
        allow read: if true;
        allow create, update: if request.auth.uid != null;
    }
  }
}
