rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /users/{userId} {
      // Any authenticated user can view public user profiles.
      allow read: if isAuthenticated();
      // A user can only create their own document.
      allow create: if isOwner(userId);
      // A user can update their own document. Another user can ONLY update walletBalance during a sale.
      allow update: if isOwner(userId) || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletBalance']));
      
      match /holdings/{holdingId} {
        // A user can only manage their own holdings.
        allow read, create, update: if isOwner(userId);
        // Any authenticated user can be part of a transaction that deletes a holding (i.e., a sale).
        allow delete: if isAuthenticated();
      }

      match /privateHoldings/{holdingId} {
         // A user can only manage their own private holdings.
        allow list, create, update: if isOwner(userId);
        // Any authenticated user can get/delete a specific holding as part of a transaction.
        allow get, delete: if isAuthenticated();
      }
    }

    match /artists/{artistId} {
      allow read: if true;
      // An authenticated user can create an artist profile linked to their user ID.
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Any authenticated user can perform marketplace updates on an artist's profile.
      allow update: if isAuthenticated();
    }
    
    match /fractals/{fractalId} {
      allow read: if true;
      // Any authenticated user (specifically, the artist owner) can create or update artwork.
      allow create, update: if isAuthenticated();
    }

    match /resaleListings/{listingId} {
      allow read: if true;
      // The reseller must be the one creating the listing.
      allow create: if isAuthenticated() && request.resource.data.resellerId == request.auth.uid;
      // Any authenticated user can update a listing (i.e., a buyer taking shares).
      allow update: if isAuthenticated();
    }
  }
}
