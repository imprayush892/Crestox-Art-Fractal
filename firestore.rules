rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow a new user to create their own document.
      // This rule is secure because it checks that the UID in the document data
      // matches the document ID, preventing users from creating profiles for others.
      allow create: if request.resource.data.uid == userId;
      
      // Allow authenticated users to read and update their own documents.
      allow read, update: if request.auth != null && request.auth.uid == userId;
    }

    // Artists can be read by anyone, but only managed by the user they belong to.
    match /artists/{artistId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Fractals can be read by anyone, but only managed by the artist who created them.
    match /fractals/{fractalId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && get(/databases/$(database)/documents/artists/$(resource.data.artistId)).data.userId == request.auth.uid;
    }

    // Resale listings can be read by anyone, but only managed by the reseller.
    match /resaleListings/{listingId} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.resellerId;
        allow update: if request.auth != null && request.auth.uid == resource.data.resellerId;
    }

    // Users can manage their own holdings.
     match /users/{userId}/holdings/{holdingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
