rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. User Profiles
    // Allows users to create their own profile upon signup.
    // They can only read and update their own document.
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // Users cannot delete their profiles.
    }

    // 2. Artist Profiles
    // Anyone can view artist profiles for the gallery.
    // The artist can update their own profile freely.
    // A collector's transaction can ONLY decrement the availableEditions.
    match /artists/{artistId} {
      allow create: if request.auth != null && request.auth.uid == artistId;
      allow read: if true;
      allow update: if (request.auth != null && request.auth.uid == artistId) ||
                     (
                       request.auth != null &&
                       request.resource.data.availableEditions < resource.data.availableEditions &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availableEditions'])
                     );
      allow delete: if false;
    }

    // 3. Fractals (Artwork)
    // All artwork is public to browse.
    // Only an authenticated user can create artwork.
    // Only the original artist can update or delete their artwork.
    match /fractals/{fractalId} {
      allow create: if request.auth != null && request.resource.data.artistId == request.auth.uid;
      allow read: if true;
      allow update: if request.auth != null && resource.data.artistId == request.auth.uid;
      allow delete: if false;
    }
    
    // 4. User Holdings (Fractals owned by users)
    // Users can only access their own holdings subcollection.
    match /users/{userId}/holdings/{holdingId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // 5. Resale Listings
    // The marketplace is public to view.
    // Only authenticated users can create listings for items they own.
    // Only the seller can cancel (update) their own listing.
    match /resaleListings/{listingId} {
      allow create: if request.auth != null && request.resource.data.resellerId == request.auth.uid;
      allow read: if true;
      allow update: if request.auth != null && resource.data.resellerId == request.auth.uid;
      allow delete: if false;
    }
  }
}
