
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletBalance']));
      
      match /holdings/{holdingId} {
        // This is the key fix: Adding 'list' permission for the collectionGroup query.
        allow list, read: if isAuthenticated();
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isAuthenticated(); 
      }
      
      match /privateHoldings/{holdingId} {
        allow get: if isAuthenticated(); // Allow get for transaction verification
        allow list, read: if isOwner(userId); // But only allow listing for the owner
        allow create, update: if isOwner(userId);
        allow delete: if isAuthenticated();
      }
    }
    
    match /artists/{artistId} {
      allow read: if true;
      allow update: if isAuthenticated();
    }
    
    match /fractals/{fractalId} {
      allow read: if true;
      allow update: if isAuthenticated();
    }
    
    match /resaleListings/{listingId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
    }
  }
}
