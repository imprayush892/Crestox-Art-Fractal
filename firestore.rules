
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // PUBLIC DATA
    match /artists/{artistId} {
      allow read: if true;
      // Allow any authenticated user to update artist data like price and counts
      // as part of a transaction. Artist can create/delete their own profile.
      allow update: if isAuthenticated();
      allow create, delete: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /fractals/{fractalId} {
      allow read: if true;
      // Only the artist who owns the artwork can modify it.
      allow write: if isAuthenticated() && get(/databases/$(database)/documents/artists/$(request.resource.data.artistId)).data.userId == request.auth.uid;
    }
    
    match /resaleListings/{listingId} {
      allow read: if true;
      // Any authenticated user can create a listing.
      // Only the listing owner can update it (e.g., to cancel).
      // The purchase transaction also needs to update it.
      allow create: if isAuthenticated() && request.resource.data.resellerId == request.auth.uid;
      allow update: if isAuthenticated();
    }

    // USER DATA
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      // Allow a user to update their own document.
      // ALSO, allow any authenticated user to update ANOTHER user's document
      // IF AND ONLY IF the only field being changed is 'walletBalance'.
      // This is crucial for the marketplace transaction to credit the seller.
      allow update: if isOwner(userId) || (
        isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletBalance'])
      );
      
      // PRIVATE HOLDINGS (only owner can access)
      match /privateHoldings/{holdingId} {
        allow read, write: if isOwner(userId);
      }

      // PUBLIC HOLDINGS
      match /holdings/{holdingId} {
        // Owner can read their holdings.
        allow read: if isOwner(userId);
        // Allow creating for self.
        allow create: if isOwner(userId);
        // Allow deleting for anyone authenticated (as part of a sale).
        allow delete: if isAuthenticated();
        // Allow owner to update status (e.g., from 'owned' to 'listed').
        allow update: if isOwner(userId);
      }
    }
  }
}
