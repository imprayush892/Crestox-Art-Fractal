rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      
      match /privateHoldings/{holdingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /holdings/{holdingId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /artists/{artistId} {
      allow read;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && get(/databases/$(database)/documents/artists/$(artistId)).data.userId == request.auth.uid;
    }

    match /fractals/{fractalId} {
      allow read;
      allow create: if request.auth != null 
                    && get(/databases/$(database)/documents/artists/$(request.resource.data.artistId)).data.userId == request.auth.uid;
      allow update: if request.auth != null 
                    && get(/databases/$(database)/documents/artists/$(resource.data.artistId)).data.userId == request.auth.uid;
    }
    
    match /resaleListings/{listingId} {
      allow read;
      allow create: if request.auth != null && request.resource.data.resellerId == request.auth.uid;
      allow update: if request.auth != null;
    }

    match /{path=**}/holdings/{holdingId} {
       allow read: if request.auth != null;
    }
  }
}
